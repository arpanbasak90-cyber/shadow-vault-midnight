// Compact Smart Contract: Counter
// Language: Compact (Midnight Network DSL)
// Version constraint: compact >= 0.27.0;

pragma language_version >= 0.27.0;

/**
 * =============================================================================
 * COUNTER SMART CONTRACT - PRIVACY MODEL & BOUNDARIES
 * =============================================================================
 * 
 * PUBLIC LEDGER STATE (On-chain, globally visible to all nodes):
 *   - counter_value: Uint<64> - Current public counter tally.
 *   - owner: Bytes<32> - Public key hash of the contract owner.
 *   - is_initialized: Boolean - Status flag tracking whether contract is initialized.
 * 
 * PRIVATE WITNESS INPUTS (Off-chain, zero-knowledge context):
 *   - witness get_increment_secret(): Uint<64> - Private increment step value.
 *     Supplied off-chain during ZK proof generation.
 * 
 * DELIBERATE DISCLOSURE BOUNDARY:
 *   - disclose(new_value): Only the calculated new total is disclosed on-chain.
 *     The raw secret increment step value is NEVER stored or exposed on-chain.
 * =============================================================================
 */

module Counter {
    // =========================================================================
    // PUBLIC LEDGER STATE
    // =========================================================================
    export ledger counter_value: Uint<64>;
    export ledger owner: Bytes<32>;
    export ledger is_initialized: Boolean;

    // =========================================================================
    // PRIVATE WITNESS INTERFACE
    // =========================================================================
    witness get_increment_secret(): Uint<64>;

    // =========================================================================
    // CIRCUITS
    // =========================================================================
    export circuit initialize(initial_owner: Bytes<32>): Void {
        assert !is_initialized "Counter is already initialized";
        owner = initial_owner;
        counter_value = 0u64;
        is_initialized = true;
    }

    export circuit increment(): Uint<64> {
        assert is_initialized "Counter not initialized";
        let secret_step = get_increment_secret();
        // Calculate new state using private witness step
        let new_value = counter_value + secret_step;
        // DELIBERATE DISCLOSURE: Disclose only the final new counter value on-chain
        counter_value = disclose(new_value);
        return counter_value;
    }
}
